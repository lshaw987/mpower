---
import Base from '../layouts/Base.astro';
---
<Base title="Waitlist" current="Waitlist" description="The waitlist for MPower. Knowledge. Power. Yours.">

  <section class="section">
    <div class="container narrow">
      <div class="mono kicker">§ The waitlist · 2026</div>
      <h1 class="display wl-h1">
        Take what's <span class="i-accent">yours.</span>
      </h1>
      <p class="body-lg wl-lede">
        Tell us who you are and which community is yours. We'll be in touch to get you started - and you'll get something useful from us every week.
      </p>

      <ol class="wl-steps">
        <li>
          <span class="wl-num">01</span>
          <h2 class="heading wl-step-title">Pick your community.</h2>
          <p class="body-sm wl-step-body">Agri, Ed, Teams, Built, Leaders or Rising. Tell us which world is yours.</p>
        </li>
        <li>
          <span class="wl-num">02</span>
          <h2 class="heading wl-step-title">Get one useful thing a week.</h2>
          <p class="body-sm wl-step-body">A tool, a template or an idea you can use that week. Short, plain, yours to keep.</p>
        </li>
        <li>
          <span class="wl-num">03</span>
          <h2 class="heading wl-step-title">We get you started.</h2>
          <p class="body-sm wl-step-body">You hear from us with your next step, and what's open for you right now.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      {/* Klaviyo embedded form. Powered by the onsite script + init in
          Base.astro (company SKABCW). The form fields, validation, success
          state and double opt-in are all managed in Klaviyo - this div is
          the mount point. Per the 18 May 2026 spec. */}
      <div class="klaviyo-form-W2JdnP"></div>

      <noscript>
        <p class="body wl-fallback">
          The waitlist form needs JavaScript. If it isn't loading, email
          <a href="mailto:askme@mpowerhq.nz">askme@mpowerhq.nz</a> and we'll add you by hand.
        </p>
      </noscript>

      <p class="body wl-fallback" data-kl-fallback hidden>
        Can't see the form? Your browser may be blocking it - email
        <a href="mailto:askme@mpowerhq.nz?subject=waitlist">askme@mpowerhq.nz</a> with 'waitlist' and we'll add you.
      </p>

      <p class="body-sm wl-promise">
        We won't sell your address. We won't spam. We'll write once a week, one thing you can use, and if a week has nothing worth your time, you won't hear from us. Nobody is ever selling you anything in here, including us.
      </p>

      <p class="body wl-now">
        Don't want to wait? <a href="/resources">The free resources are open now <span class="arr">→</span></a>
      </p>
    </div>
  </section>

</Base>

<style>
  .narrow { max-width: 920px; }
  .kicker { color: var(--c-spring); margin-bottom: 32px; }
  .wl-h1 { font-size: var(--t-h1); line-height: 1.04; padding-bottom: 0.12em; }
  .wl-lede { margin-top: 32px; max-width: 60ch; opacity: .9; }

  .wl-steps {
    list-style: none; padding: 0; margin-top: 48px;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
  }
  .wl-steps li {
    padding: 24px 24px 8px 0;
    border-top: 1px solid var(--c-rule);
    display: flex; flex-direction: column; gap: 10px;
  }
  .wl-num {
    font-family: var(--f-display); font-weight: 800; color: var(--c-spring);
    font-size: clamp(28px, 3vw, 40px); line-height: 1; letter-spacing: -0.04em;
  }
  .wl-step-title { font-size: var(--t-body-lg); }
  .wl-step-body { opacity: .85; max-width: 30ch; }
  @media (max-width: 720px) { .wl-steps { grid-template-columns: 1fr; } }

  .wl-now { margin-top: 28px; }
  .wl-now a { color: var(--c-spring); font-weight: 600; }

  .klaviyo-form-W2JdnP { margin-top: 8px; min-height: 120px; }

  .wl-fallback { margin-top: 24px; opacity: .9; }
  .wl-fallback[hidden] { display: none; }
  .wl-fallback a { color: var(--c-spring); }

  .wl-promise {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--c-rule);
    max-width: 560px;
    font-style: italic;
    opacity: .85;
  }
</style>

<script is:inline>
  // Klaviyo fallback. If an ad-blocker stops klaviyo.js the form div stays
  // empty; after 3s, show the plain-email line instead of a blank space.
  // If the form turns up late (slow connection), hide the line again.
  (function () {
    var form = document.querySelector('.klaviyo-form-W2JdnP');
    var fb = document.querySelector('[data-kl-fallback]');
    if (!form || !fb) return;
    var sync = function () {
      if (form.children.length === 0) fb.removeAttribute('hidden');
      else fb.setAttribute('hidden', '');
    };
    setTimeout(function () {
      sync();
      if ('MutationObserver' in window) new MutationObserver(sync).observe(form, { childList: true });
    }, 3000);
  })();
</script>
