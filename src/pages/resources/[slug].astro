---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const all = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: i > 0 ? all[i - 1] : null,
      next: i < all.length - 1 ? all[i + 1] : null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'resources'>;
  prev: CollectionEntry<'resources'> | null;
  next: CollectionEntry<'resources'> | null;
}
const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const formatHref = `/resources?format=${encodeURIComponent(d.format)}`;
const themeHref = `/resources?theme=${encodeURIComponent(d.theme)}`;
---
<Base title={d.title} current="Resources" description={d.summary}>

  <article class="section-tight">
    <div class="container narrow">
      <nav class="mono crumb" aria-label="Breadcrumb">
        <a href="/resources">Resources</a> <span class="crumb-sep" aria-hidden="true">›</span>
        <span class="crumb-here">{d.format}</span>
      </nav>

      <div class="pills">
        <a href={formatHref} class="pill pill-format">{d.format}</a>
        <a href={themeHref} class="pill pill-theme">{d.theme}</a>
      </div>

      <h1 class="display art-h1">{d.title}</h1>
      <p class="body-lg art-standfirst">{d.summary}</p>

      <div class="art-meta">
        <span class="mono">{d.readingTime} min read</span>
        {d.pdf && (
          <a href={d.pdf} class="btn btn-primary art-pdf" download>Download the PDF <span class="arr">↓</span></a>
        )}
      </div>

      <hr class="rule" style="margin-block: 40px;" />

      {d.book && (
        <aside class="book">
          <span class="mono book-label">The book</span>
          <p class="book-line"><strong>{d.book.title}</strong> <span class="book-sep">·</span> {d.book.author}</p>
        </aside>
      )}

      <div class="art-body">
        <Content />
      </div>

      <p class="mono art-source">Source: {d.source}</p>

      <hr class="rule" style="margin-top: 48px;" />

      <aside class="taste">
        <p class="body">
          This is a taste. Members get the lot - webinars, recordings, Ask Lisa and more.
          <a href="/waitlist">Join the waitlist <span class="arr">→</span></a>
        </p>
      </aside>

      <nav class="pn" aria-label="More resources">
        {prev ? (
          <a href={`/resources/${prev.slug}`} class="pn-link pn-prev">
            <span class="mono">← Previous</span>
            <span class="pn-title">{prev.data.title}</span>
          </a>
        ) : <span class="pn-spacer"></span>}
        {next ? (
          <a href={`/resources/${next.slug}`} class="pn-link pn-next">
            <span class="mono">Next →</span>
            <span class="pn-title">{next.data.title}</span>
          </a>
        ) : <span class="pn-spacer"></span>}
      </nav>
    </div>
  </article>

</Base>

<style>
  .narrow { max-width: 820px; }

  .crumb { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--c-fog); }
  .crumb a { color: var(--c-spring); }
  .crumb a:hover { text-decoration: underline; }
  .crumb-sep { opacity: .6; }
  .crumb-here { color: var(--c-fog); opacity: .8; }

  .pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .pill {
    display: inline-flex; align-items: center;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--c-rule);
    font-family: var(--f-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    transition: border-color .15s var(--ease-out), color .15s var(--ease-out);
  }
  .pill-format { color: var(--c-spring); border-color: rgba(74, 222, 128, 0.35); }
  .pill-theme { color: var(--c-fog); }
  .pill:hover { border-color: var(--c-mist); color: var(--c-mist); }

  .art-h1 { font-size: var(--t-h2); margin-top: 24px; max-width: 18ch; line-height: 1.0; padding-bottom: 0.08em; overflow-wrap: anywhere; }
  .art-standfirst { margin-top: 24px; max-width: 60ch; opacity: .9; }
  .art-meta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin-top: 28px; color: var(--c-fog); }
  .art-pdf { padding: 10px 18px; font-size: var(--t-body-sm); }

  .book {
    background: var(--c-steel);
    border: 1px solid var(--c-rule-soft);
    border-left: 3px solid var(--c-spring);
    border-radius: 0 4px 4px 0;
    padding: 16px 20px;
    margin-bottom: 32px;
    max-width: 68ch;
  }
  .book-label { color: var(--c-spring); display: block; margin-bottom: 8px; }
  .book-line { font-size: var(--t-body); line-height: 1.5; opacity: .92; }
  .book-line strong { font-weight: 700; }
  .book-sep { color: var(--c-fog); margin-inline: 4px; }

  /* Rendered markdown - comfortable reading measure. */
  .art-body {
    max-width: 68ch;
    font-size: clamp(17px, 0.3vw + 16px, 18px);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .art-body :global(h2) {
    font-family: var(--f-display); font-weight: 700; letter-spacing: -0.02em;
    font-size: var(--t-h4); line-height: 1.15;
    margin-top: 44px; margin-bottom: 12px;
  }
  .art-body :global(h2:first-child) { margin-top: 0; }
  .art-body :global(h3) {
    font-family: var(--f-display); font-weight: 700; letter-spacing: -0.015em;
    font-size: clamp(19px, 0.6vw + 16px, 22px); line-height: 1.25;
    margin-top: 32px; margin-bottom: 8px;
  }
  .art-body :global(h4) { font-weight: 700; margin-top: 24px; margin-bottom: 6px; }
  .art-body :global(p) { margin-top: 16px; opacity: .9; }
  .art-body :global(ul), .art-body :global(ol) { margin-top: 16px; padding-left: 24px; opacity: .9; }
  .art-body :global(li) { margin-top: 8px; }
  .art-body :global(li > ul), .art-body :global(li > ol) { margin-top: 6px; }
  .art-body :global(strong) { color: var(--c-mist); font-weight: 600; }
  .art-body :global(em) { font-style: italic; }
  .art-body :global(a) { color: var(--c-spring); }
  .art-body :global(a:hover) { text-decoration: underline; }
  .art-body :global(blockquote) {
    margin: 24px 0 0; padding-left: 18px;
    border-left: 2px solid var(--c-spring);
    font-style: italic; color: var(--c-mist); opacity: .9;
  }
  .art-body :global(blockquote p) { margin-top: 0; }
  .art-body :global(hr) { height: 1px; background: var(--c-rule); border: 0; margin-block: 36px; }
  .art-body :global(code) {
    font-family: var(--f-mono); font-size: 0.9em;
    background: var(--c-steel); padding: 2px 6px; border-radius: 3px;
  }
  .art-body :global(pre) {
    margin-top: 16px; padding: 16px; border-radius: 4px;
    background: var(--c-steel); border: 1px solid var(--c-rule-soft);
    overflow-x: auto; font-size: 0.9em; line-height: 1.5;
  }
  .art-body :global(pre code) { background: none; padding: 0; }
  .art-body :global(table) {
    display: block; overflow-x: auto; margin-top: 20px;
    border-collapse: collapse; font-size: var(--t-body-sm); line-height: 1.5;
  }
  .art-body :global(th), .art-body :global(td) {
    text-align: left; padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--c-rule); vertical-align: top;
    overflow-wrap: normal; min-width: 9ch; /* wrap on spaces, never mid-word; the table scrolls instead */
  }
  .art-body :global(th) { font-family: var(--f-mono); font-size: var(--t-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-fog); font-weight: 500; }
  .art-body :global(img) { border-radius: 4px; margin-top: 20px; }
  .art-body :global(input[type="checkbox"]) { accent-color: var(--c-spring); margin-right: 8px; }

  .art-source { margin-top: 40px; color: var(--c-fog); }

  .taste { margin-top: 32px; max-width: 60ch; }
  .taste p { color: var(--c-mist); opacity: .88; }
  .taste a { color: var(--c-spring); font-weight: 600; white-space: nowrap; margin-left: 6px; }
  .taste a:hover .arr { transform: translateX(3px); }
  .taste .arr { display: inline-block; transition: transform .2s var(--ease-out); }

  .pn {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    margin-top: 48px; padding-top: 32px;
    border-top: 1px solid var(--c-rule-soft);
  }
  .pn-link { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .pn-link .mono { color: var(--c-fog); }
  .pn-next { text-align: right; align-items: flex-end; }
  .pn-title { font-family: var(--f-display); font-weight: 700; letter-spacing: -0.02em; font-size: var(--t-body-lg); line-height: 1.25; overflow-wrap: anywhere; }
  .pn-link:hover .pn-title { color: var(--c-spring); }

  @media (max-width: 480px) {
    .pn { grid-template-columns: 1fr; }
    .pn-next { text-align: left; align-items: flex-start; }
    .pn-spacer { display: none; }
  }
</style>
